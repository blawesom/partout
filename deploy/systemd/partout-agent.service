[Unit]
Description=Partout agent (outbound-only host agent)
After=network-online.target
Wants=network-online.target
# M8.1: a crashlooping post-update binary must keep restarting until the
# boot guard's health window (PARTOUT_UPDATE_HEALTH_S + grace) declares the
# marker stale and rolls back to N-1 (~180 s). systemd's default start
# limit (5 starts / 10 s) would park the unit in `failed` first and the
# rollback would never run. 0 disables the start rate limit.
StartLimitIntervalSec=0

[Service]
Type=simple
User=partout
# Server address + (first-run only) enrollment token come from agent.env.
EnvironmentFile=-/etc/partout/agent.env
# M8.1: the boot guard supervises the binary swap (rolls a failed
# self-update back to N-1 before the agent starts), then execs the real
# binary with the same args. Its health window must match the agent's
# PARTOUT_UPDATE_HEALTH_S (agent.env).
Environment=PARTOUT_AGENT_DATA_DIR=/var/lib/partout/agent
ExecStart=/usr/local/sbin/partout-update-guard --mode=agent --data-dir=/var/lib/partout/agent
Restart=always
RestartSec=3
# Hardening: the agent only opens outbound connections.
NoNewPrivileges=true
ProtectSystem=full
# File root (docs/spec-file-root.md): the file surface is jailed to
# /home/partout. ProtectHome=read-only keeps /home,/root,/run/user
# read-only EXCEPT the carved-out root below — ProtectHome=true hid
# /home/partout entirely and disabled the file surface even when the
# directory existed.
ProtectHome=read-only
ReadWritePaths=/var/lib/partout /home/partout
PrivateTmp=true

[Install]
WantedBy=multi-user.target