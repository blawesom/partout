# Partout embedded-mode runtime environment (loaded by partout-embedded.service).
# Embedded = server + co-located local agent in one process: the fastest
# path for a single self-managed host (see README quick start).
#
# Generate a password:  openssl rand -base64 18

# Web-UI admin user bootstrap (required for the login form).
PARTOUT_ADMIN_PASSWORD=

# ---- RBAC (all three optional; if none set, single-user local mode) ----
PARTOUT_TOKEN_ADMIN=
PARTOUT_TOKEN_OPERATOR=
PARTOUT_TOKEN_VIEWER=

# ---- Listener (default :8443, all interfaces) ----
# PARTOUT_PORT=8443
# Behind a reverse proxy on the same host, bind loopback-only:
# PARTOUT_ADDR=127.0.0.1

# ---- TLS (optional; off by default) ----
# PARTOUT_TLS=on
# PARTOUT_TLS_SERVER_NAMES=localhost,127.0.0.1,partout.example.internal

# Data (db + local agent identity) under one dir:
# PARTOUT_DB_PATH=/var/lib/partout/partout.db
