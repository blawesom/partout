# Partout agent runtime environment.
# PARTOUT_SERVER is required: host:port of the Partout server (agent connects
# outbound only — no inbound ports needed on this host).
PARTOUT_SERVER=10.0.0.5:8443

# PARTOUT_TOKEN is only needed for FIRST-TIME enrollment (with a fresh
# identity). Remove it after the first successful enrollment; the agent then
# authenticates with its persisted identity key.
# PARTOUT_TOKEN=par_enr_...

# Identity + policy storage (default: /var/lib/partout/agent).
PARTOUT_DATA_DIR=/var/lib/partout/agent

# Facts refresh cadence, seconds (default 3600).
# PARTOUT_FACTS_INTERVAL=3600

# ---- TLS (optional; only when the server runs with PARTOUT_TLS=on) ----
# PARTOUT_TLS_CA is the server's root CA (PEM). When set, the agent enrolls
# over HTTPS, obtains a CA-signed client cert (mTLS), and persists it under
# <PARTOUT_DATA_DIR>/tls/. Without it the agent uses plaintext h2c.
# PARTOUT_TLS_CA=/etc/partout/ca.crt

# ---- Elevation (optional; default none) ----
# PARTOUT_ELEVATE=sudo makes the agent run its action commands (dispatched
# exec, PTY sessions, package apply, task steps, reboot) through `sudo -n`,
# and retry root-only config reads via `sudo -n cat`. What may actually
# elevate is scoped by the host's sudoers file (deploy/sudoers/partout-agent)
# — install that drop-in first, and remove NoNewPrivileges=true from the
# agent unit (sudo needs setuid). Default `none` keeps everything
# unprivileged and fails closed on anything that needs root.
# PARTOUT_ELEVATE=sudo

# ---- M8.1 self-update (optional) ----
# PARTOUT_RELEASE_KEY is the base64 Ed25519 release public key this agent
# trusts for self-update artifacts. Without it the agent refuses every
# update directive (fails closed). A locally provisioned key always wins
# over anything server-delivered.
# PARTOUT_UPDATE_HEALTH_S: post-swap health window, seconds (default 60).
# The new version must boot + connect within it or the boot guard rolls
# back to N-1.
# PARTOUT_RELEASE_KEY=
# PARTOUT_UPDATE_HEALTH_S=60
