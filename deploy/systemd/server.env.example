# Partout server runtime environment (loaded by partout-server.service).
# Set real random values before enabling the service.
#
# Generate a token:  openssl rand -hex 24

# ---- RBAC (all three optional; if none set, single-user local mode) ----
PARTOUT_TOKEN_ADMIN=
PARTOUT_TOKEN_OPERATOR=
PARTOUT_TOKEN_VIEWER=

# ---- TLS (optional; off by default) ----
# PARTOUT_TLS=on|off
# When on, the server generates a local root CA + its own leaf cert on first
# run under <db dir>/tls/. The CA is the trust anchor; the leaf's SANs come
# from PARTOUT_TLS_SERVER_NAMES (default: localhost,127.0.0.1,hostname).
# PARTOUT_TLS=off
# PARTOUT_TLS_SERVER_NAMES=localhost,127.0.0.1,control.example.internal